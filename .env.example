# PRD Architect AI Configuration
# Optional: Set your OpenAI-compatible API key or other LLM providers.
# If left blank, the application automatically uses its built-in deterministic local intelligence engine (100% offline & functional).

# OpenAI or OpenAI-Compatible (OpenRouter, Groq, DeepSeek, LocalAI, vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# System Defaults
NEXT_PUBLIC_APP_NAME="PRD Architect"
NEXT_PUBLIC_APP_VERSION="1.0.0"
